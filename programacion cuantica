#!/usr/bin/env bash
Script de Configuración Automática - Laboratorio de Programación Cuántica con Qiskit
Entorno: Ubuntu 22.04 LTS (x86_64)
set -e
echo "=== [Paso 1.1] Actualizando índices de paquetes ==="
sudo apt update && sudo apt upgrade -y
echo "=== [Paso 1.2] Instalando Python 3, Venv y herramientas de compilación C++ (AVX2) ==="
sudo apt install -y python3 python3-pip python3-venv python3-dev build-essential git
echo "=== [Paso 1.3] Creando directorio de trabajo ~/laboratorio_cuantica ==="
mkdir -p ~/laboratorio_cuantica && cd ~/laboratorio_cuantica
echo "=== [Paso 1.4] Creando y activando entorno virtual aislado (.venv) ==="
python3 -m venv .venv
source .venv/bin/activate
echo "=== [Paso 1.5] Instalando Qiskit 1.x, Qiskit-Aer y Matplotlib ==="
pip install --upgrade pip
pip install qiskit qiskit-aer matplotlib pylatexenc
echo "=== [Paso 1.6] Verificando instalación ==="
python3 -c "import qiskit, qiskit_aer; print('Qiskit Core:', qiskit.version); print('Aer Simulator OK')"